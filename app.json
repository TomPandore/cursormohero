{
  "expo": {
    "name": "Mohero",
    "slug": "mohero-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.mohero.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A1A1A"
      },
      "icon": "./assets/images/icon.png",
      "package": "com.mohero.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "EXPO_PUBLIC_SUPABASE_ANON_KEY": "eyJh...Wc",
      "EXPO_PUBLIC_SUPABASE_URL": "https://dsfcihmminimtdqwwqmj.supabase.co",
      "router": {},
      "eas": {
        "projectId": "4fd88d11-ff47-48de-ba83-d973242df4f9"
      }
    }
  }
}
